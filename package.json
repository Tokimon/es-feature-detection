{
  "name": "es-feature-detection",
  "version": "3.0.1",
  "description": "ECMAScript feature and API detection",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./builtins": {
      "types": "./dist/builtins/index.d.ts",
      "default": "./dist/builtins/index.js"
    },
    "./localization": {
      "types": "./dist/localization/index.d.ts",
      "default": "./dist/localization/index.js"
    },
    "./syntax": {
      "types": "./dist/syntax/index.d.ts",
      "default": "./dist/syntax/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build": "bun run build:index && bun run compile && bun run readme",
    "build:index": "./bin/build-index.sh",
    "compile": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f",
    "typecheck": "tsc --noEmit",
    "clean": "bun run clean:compile && bun run clean:index",
    "clean:compile": "rm -rf dist",
    "clean:index": "./bin/clean-index.sh",
    "prepublishOnly": "bun run build",
    "postpublish": "bun run clean",
    "lint": "biome check .",
    "readme": "bun bin/readme.ts && biome format --write README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://Tokimon@github.com/Tokimon/es-feature-detection.git"
  },
  "keywords": [
    "ecmascript",
    "es2023",
    "es2024",
    "es2025",
    "es2026",
    "es2027",
    "tc39",
    "feature",
    "detect",
    "check",
    "test",
    "syntax",
    "polyfill",
    "builtin"
  ],
  "author": "Toke Voltelen <tokevoltelen@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tokimon/es-feature-detection/issues"
  },
  "homepage": "https://github.com/Tokimon/es-feature-detection#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/bun": "^1.4.5",
    "tsc-alias": "^1.9.11",
    "typescript": "^7.0.2"
  }
}
